{
  "about": "Conformance cases for worldarray's metadata reading (spec, Conventions 1 and 4). Each case is a store described by its attribute documents (shape and lists in the store's own order: C order for zarr, x-first for N5 attributes and precomputed) and what the package must report, in the store's own units. chunkmirage's TypeScript side builds the same stores from this file. 'expect' is the package's reading; a case with 'layered' also says what chunkmirage derives from the raw attributes.",
  "cases": [
    {
      "name": "n5_is_transposed_to_c_order_with_resolution_and_offset",
      "format": "n5",
      "shape": [
        4,
        6,
        8
      ],
      "attrs": {
        "resolution": [
          8,
          4,
          2
        ],
        "offset": [
          80,
          40,
          20
        ]
      },
      "expect": {
        "voxel_size": [
          2,
          4,
          8
        ],
        "translation": [
          21,
          42,
          84
        ],
        "axes": [
          "z",
          "y",
          "x"
        ],
        "units": [
          "",
          "",
          ""
        ],
        "axes_named": false,
        "placed_by": "n5"
      }
    },
